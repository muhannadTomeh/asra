# Supabase Postgres connection (backend)
SUPABASE_HOST=your-project.supabase.co
SUPABASE_PORT=6543
SUPABASE_DB=postgres
SUPABASE_USER=postgres.YOUR_USER
SUPABASE_PASSWORD=YOUR_PASSWORD
SUPABASE_CONNECTION_STRING=Host=${SUPABASE_HOST};Port=${SUPABASE_PORT};Database=${SUPABASE_DB};Username=${SUPABASE_USER};Password=${SUPABASE_PASSWORD};SSL Mode=Require;Trust Server Certificate=true

# Frontend API base URL (optional override)
VITE_API_BASE_URL=https://localhost:7127/api